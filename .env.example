# Server
PORT=8080
CACHE_SECONDS=60

# Navasan free plan: keep this at 21600 (6 hours) to stay near 120 calls/month.
# Paid plans can use 60 for one-minute refresh.
NAVASAN_CACHE_SECONDS=86400
NAVASAN_API_KEY=
# Keep 1 if API values are Toman; set 10 if your account returns Rial.
NAVASAN_VALUE_DIVISOR=1
# Navasan's `sekkeh` quote is expressed in thousands of Toman.
NAVASAN_COIN_MULTIPLIER=1000

# Domestic open-market rates in Toman.
# Used as fallback when NAVASAN_API_KEY is empty or its service is unavailable.
USD_TOMAN=93250
COIN_IMAMI_TOMAN=78240000

# Optional: recommended for more reliable CoinGecko quota.
COINGECKO_API_KEY=
